# Copy to .env and adjust. gauntlets/run.mjs auto-loads .env (real shell env wins).
#
# Defaults below match the bundled proxy (gauntlets/litellm-config.example.yaml):
# run that proxy with your $ANTHROPIC_API_KEY and this file works as-is, no external
# repo involved. To use a different provider instead, point GAUNTLET_BASE_URL at any
# OpenAI-compatible endpoint (OpenAI, Anthropic-compatible gateway, Google, ...) and
# set the model ids to whatever it serves.

# Endpoint and key.
GAUNTLET_BASE_URL=http://localhost:4000/v1
GAUNTLET_API_KEY=sk-noauth

# Model ids your endpoint serves. This mirrors the original eval: Opus drives each
# process and reviews the specs; Sonnet plays the stakeholder. To compare a process
# across models, change GAUNTLET_AUTHOR_MODEL and keep the other two fixed.
GAUNTLET_AUTHOR_MODEL=claude-opus
GAUNTLET_STAKEHOLDER_MODEL=claude-sonnet
GAUNTLET_AUDITOR_MODEL=claude-opus

# max_tokens per call. Raise it if your endpoint reserves a reasoning/thinking budget.
GAUNTLET_MAX_TOKENS=16384

# Engine. Default (unset or "openai") drives every call through the OpenAI-compatible
# endpoint above, model-agnostic and needing no local CLIs. Set "claude" to run each cell
# as a real `claude -p` agent on your Claude subscription, with the `allium check` hook
# firing on every spec write (the whiteboard loop a real Allium user has). The claude
# engine needs the `claude` and `allium` CLIs on PATH and ignores the endpoint above.
# GAUNTLET_ENGINE=claude
