-- allium: 4
component Rulebook
  entity R
  observable state has_code(R) : bool
  observable state intragroup(R) : bool
  observable state has_prior_uti(R) : bool
  observable state new_trade(R) : bool
  observable state collateralised(R) : bool
  observable state has_uti(R) : bool
  observable state bespoke(R) : bool
  observable state reconciled(R) : bool
  observable state has_pkg_id(R) : bool
  observable state has_factor(R) : bool
  observable state has_ts(R) : bool
  observable state package(R) : bool
  observable state confirmed(R) : bool
  observable state allocation(R) : bool
  observable state cleared(R) : bool
  observable state has_ccp_lei(R) : bool
  observable state credit(R) : bool

  axiom r1 means not (has_code(r) and intragroup(r))
  axiom r2 means not has_prior_uti(r)
  axiom r3 means has_code(r) implies new_trade(r)
  axiom r4 means collateralised(r) implies has_code(r)
  axiom r5 means has_uti(r) implies bespoke(r)
  axiom r6 means not (has_code(r) and reconciled(r))
  axiom r7 means not collateralised(r)
  axiom r8 means has_pkg_id(r) implies has_factor(r)
  axiom r9 means not (collateralised(r) and has_pkg_id(r))
  axiom r10 means not (has_code(r) and has_ts(r))
  axiom r11 means has_factor(r) implies package(r)
  axiom r12 means has_prior_uti(r) implies confirmed(r)
  axiom r13 means has_code(r) implies bespoke(r)
  axiom r14 means not (has_factor(r) and allocation(r))
  axiom r15 means not (cleared(r) and bespoke(r))
  axiom r16 means not (has_ts(r) and has_uti(r))
  axiom r17 means has_ccp_lei(r) implies collateralised(r)
  axiom r18 means has_prior_uti(r) implies has_uti(r)
  axiom r19 means package(r)
  axiom r20 means has_uti(r) implies intragroup(r)
  axiom r21 means credit(r) implies bespoke(r)
  axiom r22 means cleared(r) implies has_ccp_lei(r)
  axiom r23 means allocation(r) implies has_pkg_id(r)
  axiom r24 means has_code(r) implies bespoke(r)
  axiom r25 means not (reconciled(r) and new_trade(r))
  axiom r26 means collateralised(r) implies has_code(r)
  axiom r27 means cleared(r)
  axiom r28 means reconciled(r) implies has_ccp_lei(r)
end
