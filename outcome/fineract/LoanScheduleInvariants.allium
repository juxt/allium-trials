-- allium: 4
-- Reference spec of the SALIENT behaviours of Fineract's progressive-loan EMI schedule
-- (fineract-progressive-loan, ProgressiveEMICalculator). Distilled from the code + pinned by
-- ProgressiveEMICalculatorTest. These are the load-bearing invariants a change must not break;
-- everything else in the 2204-line calculator (reschedules, capitalised income, re-age, ...)
-- is machinery serving them. Grounding artifact for the evolution test, and the yardstick a
-- model's own distil is scored against.
--
-- CHECKABILITY NOTE: invariants 2-6 are ARITHMETIC (rate x balance, EMI - interest, a sum).
-- The language design admits linear integer arithmetic + aggregates (NON-GOALS scope line),
-- but the v4 analyse PROTOTYPE is boolean-SAT only, so it cannot yet check these. That is a
-- real substrate finding: real financial logic needs the arithmetic tier. The structural
-- invariants (1, 5, 7 as monotonicity/termination) are the ones the prototype can approach.
component LoanSchedule
  entity Period            -- a repayment period p, ordered 0..n-1 over one loan
  given disbursed : Money  -- the disbursed principal

  observable state emi(Period) : Money
  observable state rate_factor(Period) : Rate
  observable state interest(Period) : Money
  observable state principal(Period) : Money
  observable state outstanding_start(Period) : Money   -- balance at the start of the period
  observable state is_last(Period) : bool

  -- I1 EMI-constancy: every non-final period carries the same instalment.
  invariant emi_constant means every p :: every q ::
    (not is_last(p) and not is_last(q)) implies (emi(p) = emi(q))

  -- I2 interest-on-outstanding: interest accrues on the period's opening balance.
  invariant interest_on_outstanding means every p ::
    interest(p) = rate_factor(p) * outstanding_start(p)

  -- I3 principal split: principal is the instalment net of interest.
  invariant principal_split means every p :: principal(p) = emi(p) - interest(p)

  -- I4 balance roll-forward: next opening balance is this one less principal paid.
  invariant balance_rolls means every p :: every next ::
    follows(next, p) implies (outstanding_start(next) = outstanding_start(p) - principal(p))

  -- I5 balance monotonic: the outstanding balance never increases across periods.
  invariant balance_monotonic means every p :: every next ::
    follows(next, p) implies (outstanding_start(next) <= outstanding_start(p))

  -- I6 conservation: the principal repaid over the schedule equals the disbursed amount.
  invariant conservation means sum p :: principal(p) = disbursed

  -- I7 termination: the final period closes the loan to a zero balance.
  invariant closes_to_zero means every p ::
    is_last(p) implies (outstanding_start(p) - principal(p) = 0)
end
