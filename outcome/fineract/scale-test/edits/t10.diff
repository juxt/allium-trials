+    /**
+     * Amortises a deferred fee across the loan's repayment periods, posting one balanced pair of journal entries per
+     * period instead of recognising the whole fee in a single entry. The fee is split evenly, with any rounding
+     * remainder folded into the final period so the posted amounts always sum back to the original fee.
+     *
+     * @param numberOfPeriods
+     *            the number of repayment periods to spread the fee across; a value of one (or less) recognises the whole
+     *            fee at once and is equivalent to {@link #createJournalEntriesForLoanCharges}
+     */
+    public void createAmortisedJournalEntriesForLoanCharges(final Office office, final String currencyCode,
+            final Integer accountTypeToBeDebited, final Integer accountTypeToBeCredited, final Long loanProductId, final Long loanId,
+            final String transactionId, final LocalDate transactionDate, final BigDecimal totalAmount,
+            final List<ChargePaymentDTO> chargePaymentDTOs, final int numberOfPeriods) {
+
+        if (numberOfPeriods <= 1) {
+            createJournalEntriesForLoanCharges(office, currencyCode, accountTypeToBeDebited, accountTypeToBeCredited, loanProductId, loanId,
+                    transactionId, transactionDate, totalAmount, chargePaymentDTOs);
+            return;
+        }
+
+        final BigDecimal periods = BigDecimal.valueOf(numberOfPeriods);
+        // track the unposted balance of each individual charge so any rounding remainder can be folded into the final
+        // period; the period total is then derived from those shares so every period stays balanced and the per-charge
+        // amounts always reconcile with the period total, which createJournalEntriesForLoanCharges asserts on.
+        final BigDecimal[] remainingPerCharge = new BigDecimal[chargePaymentDTOs.size()];
+        for (int i = 0; i < chargePaymentDTOs.size(); i++) {
+            remainingPerCharge[i] = chargePaymentDTOs.get(i).getAmount();
+        }
+
+        for (int period = 0; period < numberOfPeriods; period++) {
+            final boolean lastPeriod = period == numberOfPeriods - 1;
+
+            // derive the period total from the per-charge shares so the two always reconcile, whatever the rounding
+            final List<ChargePaymentDTO> periodPayments = new ArrayList<>();
+            BigDecimal amountForPeriod = BigDecimal.ZERO;
+            for (int i = 0; i < chargePaymentDTOs.size(); i++) {
+                final ChargePaymentDTO chargePaymentDTO = chargePaymentDTOs.get(i);
+                final BigDecimal chargeAmountForPeriod = lastPeriod ? remainingPerCharge[i]
+                        : chargePaymentDTO.getAmount().divide(periods, 2, RoundingMode.DOWN);
+                remainingPerCharge[i] = remainingPerCharge[i].subtract(chargeAmountForPeriod);
+                amountForPeriod = amountForPeriod.add(chargeAmountForPeriod);
+                periodPayments.add(new ChargePaymentDTO(chargePaymentDTO.getChargeId(), chargeAmountForPeriod,
+                        chargePaymentDTO.getLoanChargeId()));
+            }
+
+            createJournalEntriesForLoanCharges(office, currencyCode, accountTypeToBeDebited, accountTypeToBeCredited, loanProductId, loanId,
+                    transactionId, transactionDate, amountForPeriod, periodPayments);
+        }
+    }
