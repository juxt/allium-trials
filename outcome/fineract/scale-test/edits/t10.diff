+    /**
+     * Number of repayment periods to spread a deferred fee across. Derived from the loan's repayment transactions; falls
+     * back to one, which recognises the fee in a single entry.
+     */
+    private int numberOfRepaymentPeriods(final LoanDTO loanDTO) {
+        if (loanDTO.getNewLoanTransactions() == null) {
+            return 1;
+        }
+        final long repaymentPeriods = loanDTO.getNewLoanTransactions().stream()
+                .filter(txn -> txn.getTransactionType() != null && txn.getTransactionType().isRepaymentType()).count();
+        return repaymentPeriods > 0 ? (int) repaymentPeriods : 1;
+    }
