+    /**
+     * Nets a recovered principal amount against recovery income within the given balance holder before the journal
+     * entries are posted, so that the ledger reflects the net recovery. Both the recovery income credit and its
+     * offsetting fund source debit are reduced by the recovered principal, keeping the entry balanced.
+     */
+    public void netRecoveredPrincipalAgainstRecoveryIncome(final Long loanProductId, final Long paymentTypeId,
+            final BigDecimal recoveredPrincipal, final GLAccountBalanceHolder glAccountBalanceHolder) {
+        if (!MathUtil.isGreaterThanZero(recoveredPrincipal)) {
+            return;
+        }
+        final BigDecimal netAdjustment = recoveredPrincipal.negate();
+        final GLAccount recoveryIncomeAccount = getLinkedGLAccountForLoanProduct(loanProductId,
+                CashAccountsForLoan.INCOME_FROM_RECOVERY.getValue(), paymentTypeId);
+        glAccountBalanceHolder.addToCredit(recoveryIncomeAccount, netAdjustment);
+        final GLAccount fundSourceAccount = getLinkedGLAccountForLoanProduct(loanProductId, CashAccountsForLoan.FUND_SOURCE.getValue(),
+                paymentTypeId);
+        glAccountBalanceHolder.addToDebit(fundSourceAccount, netAdjustment);
+    }
