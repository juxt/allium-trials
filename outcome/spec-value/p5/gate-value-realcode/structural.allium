-- allium: 4
component LoanSchedule
  entity Period
  given disbursed : Money
  observable state emi(Period) : Money
  observable state interest(Period) : Money
  observable state principal(Period) : Money
  observable state outstanding_start(Period) : Money
  observable state rate_factor(Period) : Rate
  observable state is_last(Period) : bool
  invariant emi_constant means every p :: every q :: (not is_last(p) and not is_last(q)) implies emi(p) = emi(q)
  invariant principal_split means every p :: principal(p) = emi(p) - interest(p)
  invariant balance_rolls means every p :: every next :: follows(next, p) implies outstanding_start(next) = outstanding_start(p) - principal(p)
  invariant balance_monotonic means every p :: every next :: follows(next, p) implies outstanding_start(next) <= outstanding_start(p)
  invariant conservation means sum p :: principal(p) = disbursed
  invariant closes_to_zero means every p :: is_last(p) implies outstanding_start(p) - principal(p) = 0
end
