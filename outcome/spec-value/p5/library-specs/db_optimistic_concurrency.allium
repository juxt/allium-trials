-- allium: 4
-- LIBRARY SPEC (a second, independent instance — a database, not Kafka). A store with optimistic
-- concurrency control: concurrent updates are detected by a version check, so a client that commits an
-- update WITHOUT first checking the record's version risks a lost update. The obligation on the client is
-- stated as the contract's promise: anything COMMITTED must have had its version CHECKED.
contract OptimisticConcurrency
  entity Update
  observable state committed(Update) : bool
  observable state version_checked(Update) : bool
  guarantee commit_checks_version means committed(u) implies version_checked(u)
end
