-- allium: 4
-- A NAIVE loan updater that commits without checking the version — a lost update waiting to happen under
-- concurrency. Referencing the database library spec CATCHES it: it does NOT satisfy the obligation.
use "db_optimistic_concurrency.allium"
component NaiveUpdater satisfies (db : OptimisticConcurrency)
  entity Update
  observable state committed(Update) : bool
  observable state version_checked(Update) : bool
  action commit
    ensures committed(u)
end
