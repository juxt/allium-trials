-- allium: 4
-- Capstone: a fuller ledger exercising the complete verification suite on real achronic shapes —
-- shard lifecycle (enum + terminal), watermark bound (state-guarded), monotonicity (old-based),
-- version ordering (relational arithmetic), refinement bound (where).
component Ledger
  entity Shard
  observable state status(Shard) : { healthy | corrupted }
  observable state watermark(Shard) : Number
  observable state version(Shard) : Number
  observable state ekey(Shard) : Number
  given current_offset : Number where current_offset >= 0 - 1

  init means status(s) = healthy and watermark(s) = 0 - 1 and version(s) = 0

  -- healthy shards never persist past the consumed offset
  invariant wm_bounded means status(s) = healthy implies watermark(s) <= current_offset
  -- version ordering: same key, higher version => equal-or-higher watermark
  invariant vorder means every a :: every b :: ekey(a) = ekey(b) and version(a) > version(b) implies watermark(a) >= watermark(b)
  -- This capstone does not model version changes (init pins version = 0, no action moves it). Stating that
  -- is what makes `vorder` inductive: without it, `advance` could lift a low-version shard's watermark past
  -- a higher-version same-key peer. The relational pass now checks the conjunctive guard and needs the fact
  -- (#77); it is the assumption the spec relies on, made explicit.
  invariant versions_frozen means version(s) = 0

  action advance
    requires status(s) = healthy and watermark(s) < current_offset
    ensures watermark(s) = current_offset
  action corrupt
    requires status(s) = healthy
    ensures status(s) = corrupted

  terminal status(s) = corrupted
end
