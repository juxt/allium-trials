-- allium: 4
-- TRIPWIRE for task #63. `promote_admin` sets role=admin (and `promote_user` sets role=user) while
-- active stays false, breaking `role in {user,admin} => active`. But an `in` guard is silently NOT
-- preservation-checked, so this reads CLEAN today (a false negative). When #63 expands `in` soundly it
-- flips to BREAK and this guard fails — the signal to update the manifest. All three enum values are
-- produced (guest by init, admin/user by the actions), so there is no incidental dead-state flag.
component C
  entity X
  observable state role(X) : { guest | user | admin }
  observable state active(X) : Boolean
  init means role(x) = guest and active(x) = false
  invariant privileged means role(x) in { user, admin } implies active(x)
  action promote_admin
    ensures role(x) = admin
  action promote_user
    ensures role(x) = user
end
