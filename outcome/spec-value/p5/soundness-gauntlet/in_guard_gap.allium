-- allium: 4
-- #63 REGRESSION (was a tripwire). `promote_admin` sets role=admin (and `promote_user` sets role=user)
-- while active stays false, breaking `role in {user,admin} => active`. The `in` guard is expanded to a
-- disjunction and preservation-checked, so this BREAK is caught. All three enum values are produced
-- (guest by init, admin/user by the actions), so there is no incidental dead-state flag.
component C
  entity X
  observable state role(X) : { guest | user | admin }
  observable state active(X) : Boolean
  init means role(x) = guest and active(x) = false
  invariant privileged means role(x) in { user, admin } implies active(x)
  action promote_admin
    ensures role(x) = admin
  action promote_user
    ensures role(x) = user
end
