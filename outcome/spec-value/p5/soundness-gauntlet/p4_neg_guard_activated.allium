-- allium: 4
-- phase <> pending implies out >= 0. `settle` moves phase to settled (guard becomes true) and sets
-- out to a nonneg value. Should be PRESERVED (guard true after, bound holds).
component C
  entity Op
  observable state phase(Op) : { pending | settled }
  observable state out(Op) : Money
  init means phase(o) = pending
  invariant nn means phase(o) <> pending implies out(o) >= 0
  action settle
    requires phase(o) = pending
    ensures phase(o) = settled and out(o) = 5
end
