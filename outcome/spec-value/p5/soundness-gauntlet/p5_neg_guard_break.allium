-- allium: 4
-- same, but settle sets out = -5 while making the guard true -> genuine break, must be caught.
component C
  entity Op
  observable state phase(Op) : { pending | settled | failed }
  observable state out(Op) : Money
  invariant nn means phase(o) <> pending implies out(o) >= 0
  action settle
    requires phase(o) = pending
    ensures phase(o) = settled and out(o) = 0 - 5
end
