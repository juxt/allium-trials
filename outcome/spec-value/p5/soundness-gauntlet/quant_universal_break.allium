-- allium: 4
-- QUANTIFIER guard. `every x :: role=admin => active` is broken by deactivating an admin.
component C
  entity X
  observable state role(X) : { user | admin }
  observable state active(X) : Boolean
  init means role(x) = user and active(x) = false
  invariant admins_active means every x :: role(x) = admin implies active(x)
  action deactivate
    ensures active(x) = false
end
