-- allium: 4
-- DIAGNOSTIC GUARD. An action with two separate `ensures` clauses. The parser used to keep
-- only the first and silently drop the rest, quietly changing the verdict (the aggregate pass
-- then false-alarmed because it saw only half of a balanced transfer). The tool must now emit a
-- pointed Error directing the author to combine postconditions with `and`.
component Book
  entity Acct
  observable state bal(Acct) : Money
  observable state total : Money

  invariant conserved means total = sum a :: bal(a)

  action transfer
    ensures bal(a) = old(bal(a)) - 100
    ensures bal(b) = old(bal(b)) + 100
end
