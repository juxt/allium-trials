-- allium: 4
-- #72 enum-guarded RELATIONAL break. Two-entity, enum-guarded, arithmetic bound (achronic ShardWatermarkBound
-- shape): a healthy shard's watermark must not exceed the partition offset. `race` lifts a healthy shard's
-- watermark unconditionally, breaking the bound against a partition with a lower offset. Must BREAK.
component Core
  entity Shard
  entity Part
  observable state status(Shard) : { healthy | corrupted }
  observable state wm(Shard) : Number
  observable state off(Part) : Number
  transitions status
    initial healthy
    healthy -> corrupted
    terminal corrupted
  invariant offset_nonneg means every p :: off(p) >= 0
  invariant bound means every s :: every p :: status(s) = healthy implies wm(s) <= off(p)
  action race
    requires status(s) = healthy
    ensures wm(s) = 1000000
end
