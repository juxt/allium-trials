-- allium: 4
use "store_contract.allium"
component SafeWriter satisfies (s : MetricStore)
  entity Point
  observable state appended(Point) : bool
  observable state series_created(Point) : bool
  observable state time_monotonic(Point) : bool
  invariant create_before_append means appended(p) implies series_created(p)
  invariant monotonic_time       means appended(p) implies time_monotonic(p)
end
